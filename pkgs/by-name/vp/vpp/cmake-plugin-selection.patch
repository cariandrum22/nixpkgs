Keep filtering local to add_vpp_plugin. A return() from a CMake macro exits
the calling CMakeLists.txt and skips later plugins in the same directory
(e.g. linux_nl after linux_cp). A function wrapper gives return() the intended
scope while preserving macro argument substitution inside the implementation.
Guard follow-up operations on targets which may have been filtered out.

--- a/cmake/plugin.cmake
+++ b/cmake/plugin.cmake
@@ -11,7 +11,7 @@
 # See the License for the specific language governing permissions and
 # limitations under the License.
 
-macro(add_vpp_plugin name)
+macro(_vpp_add_plugin name)
   cmake_parse_arguments(PLUGIN
     ""
     "LINK_FLAGS;COMPONENT;DEV_COMPONENT"
@@ -152,6 +152,10 @@
   )
 endmacro()
 
+function(add_vpp_plugin name)
+  _vpp_add_plugin(${name} ${ARGN})
+endfunction()
+
 macro(vpp_plugin_find_library plugin var name)
   find_library(${var} NAMES ${name} ${ARGN})
   mark_as_advanced(${var})
